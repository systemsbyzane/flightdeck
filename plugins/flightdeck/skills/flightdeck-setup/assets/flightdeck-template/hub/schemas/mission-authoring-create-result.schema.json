{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/mission-authoring-create-result.schema.json",
  "title": "Flightdeck Mission authoring create result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "operation_id", "outcome", "mission_id", "plan_id", "plan_generation", "plan_digest"],
  "properties": {
    "schema_version": {"const": "flightdeck.mission-authoring.create-result/v1"},
    "schema": {"const": "hub/schemas/mission-authoring-create-result.schema.json"},
    "ok": {"const": true},
    "operation_id": {"$ref": "mission-authoring-types.schema.json#/$defs/operationId"},
    "outcome": {"const": "created"},
    "mission_id": {"type": "string", "pattern": "^mission-[0-9a-f]{24}$"},
    "plan_id": {"type": "string", "pattern": "^plan-[0-9a-f]{48}$"},
    "plan_generation": {"type": "string", "pattern": "^generation-[0-9a-f]{48}$"},
    "plan_digest": {"$ref": "mission-authoring-types.schema.json#/$defs/sha256"}
  }
}
