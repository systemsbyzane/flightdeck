{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-detail-v2-error.schema.json",
  "title": "Flightdeck Operation Detail v2 Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "error"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-detail.error/v2"},
    "schema": {"const": "hub/schemas/operation-detail-v2-error.schema.json"},
    "ok": {"const": false},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["malformed_request", "unsupported_hub_contract", "operation_unavailable", "invalid_hub_state", "internal_error"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
