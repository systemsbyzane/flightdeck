{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-execution-retry-bind-result.schema.json",
  "title": "Flightdeck authorized agent retry bind result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "capability", "adapter", "operation_id", "execution_id", "agent_id", "binding", "recovery", "replayed"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-execution.retry-bind-result/v1"},
    "schema": {"const": "hub/schemas/operation-execution-retry-bind-result.schema.json"},
    "ok": {"const": true},
    "capability": {"const": "flightdeck.command.operation-start-recovery.v1"},
    "adapter": {"$ref": "operation-execution-types.schema.json#/$defs/adapterDescriptor"},
    "operation_id": {"$ref": "operation-execution-types.schema.json#/$defs/operationId"},
    "execution_id": {"$ref": "operation-execution-types.schema.json#/$defs/executionId"},
    "agent_id": {"$ref": "operation-execution-types.schema.json#/$defs/agentId"},
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["state", "generation", "bound_at"],
      "properties": {"state": {"const": "bound"}, "generation": {"$ref": "operation-execution-types.schema.json#/$defs/bindingGeneration"}, "bound_at": {"type": "string", "format": "date-time"}}
    },
    "recovery": {"$ref": "operation-execution-types.schema.json#/$defs/startRecovery"},
    "replayed": {"type": "boolean"}
  }
}
