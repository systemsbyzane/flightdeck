{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-execution-plan-request.schema.json",
  "title": "Flightdeck Operation execution plan request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "work_id",
    "operation_id",
    "confirmation",
    "dispatch_generation",
    "dispatch_plan_digest",
    "idempotency_key",
    "agents"
  ],
  "properties": {
    "schema_version": {
      "const": "flightdeck.operation-execution.execution-plan-request/v1"
    },
    "adapter": {
      "$ref": "operation-execution-types.schema.json#/$defs/adapterDescriptor"
    },
    "work_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/workId"
    },
    "operation_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/operationId"
    },
    "confirmation": {
      "$ref": "operation-execution-types.schema.json#/$defs/confirmation"
    },
    "dispatch_generation": {
      "type": "string",
      "pattern": "^dispatch-generation-[0-9a-f]{48}$"
    },
    "dispatch_plan_digest": {
      "$ref": "operation-execution-types.schema.json#/$defs/sha256"
    },
    "idempotency_key": {
      "$ref": "operation-execution-types.schema.json#/$defs/requestKey"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "authorized_task",
          "adapter_configuration"
        ],
        "properties": {
          "node_id": {
            "$ref": "operation-execution-types.schema.json#/$defs/identifier"
          },
          "authorized_task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "adapter_configuration": {
            "$ref": "operation-execution-types.schema.json#/$defs/adapterConfiguration"
          }
        }
      }
    }
  }
}
