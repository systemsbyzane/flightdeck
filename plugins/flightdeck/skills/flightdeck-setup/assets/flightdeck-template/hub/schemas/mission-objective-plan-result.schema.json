{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/mission-objective-plan-result.schema.json",
  "title": "Flightdeck Mission Objective Plan Result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "mission_id", "plan_id", "plan_digest", "plan_token", "mission"],
  "properties": {
    "schema_version": {"const": "flightdeck.mission-objective.plan-result/v1"},
    "schema": {"const": "hub/schemas/mission-objective-plan-result.schema.json"},
    "ok": {"const": true},
    "mission_id": {"$ref": "#/$defs/missionId"},
    "plan_id": {"type": "string", "pattern": "^plan-[0-9a-f]{48}$"},
    "plan_digest": {"$ref": "#/$defs/sha256"},
    "plan_token": {"$ref": "#/$defs/sha256"},
    "mission": {"$ref": "#/$defs/plannedMission"}
  },
  "$defs": {
    "missionId": {"type": "string", "pattern": "^mission-[0-9a-f]{24}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["queued", "working", "waiting", "approval_required", "blocked", "review_ready", "failed_validation", "cancelled", "reconcile_required"]},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "order", "title", "status", "goal"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^operation-[0-9a-f]{24}$"}, "order": {"type": "integer", "minimum": 1, "maximum": 100},
        "title": {"type": "string", "minLength": 1, "maxLength": 256}, "status": {"$ref": "#/$defs/status"}, "goal": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "plannedMission": {
      "type": "object", "additionalProperties": false, "required": ["title", "goal", "mode", "operations"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 256}, "goal": {"type": "string", "minLength": 1, "maxLength": 2048},
        "mode": {"enum": ["watch_only", "supervised"]}, "operations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/operation"}}
      }
    }
  }
}
