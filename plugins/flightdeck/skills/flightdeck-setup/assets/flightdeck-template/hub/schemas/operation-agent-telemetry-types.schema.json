{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-agent-telemetry-types.schema.json",
  "title": "Flightdeck authenticated runtime-agent telemetry types",
  "$defs": {
    "opaqueRef": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,511}$"
    },
    "nullableOpaqueRef": {
      "oneOf": [
        {"$ref": "#/$defs/opaqueRef"},
        {"type": "null"}
      ]
    },
    "runtimeAgentId": {
      "type": "string",
      "pattern": "^operation-runtime-agent-[0-9a-f]{48}$"
    },
    "runtimeEventId": {
      "type": "string",
      "pattern": "^operation-runtime-event-[0-9a-f]{48}$"
    },
    "nullableRuntimeAgentId": {
      "oneOf": [
        {"$ref": "#/$defs/runtimeAgentId"},
        {"$ref": "operation-execution-types.schema.json#/$defs/agentId"},
        {"type": "null"}
      ]
    },
    "parentAgentId": {
      "oneOf": [
        {"$ref": "#/$defs/runtimeAgentId"},
        {"$ref": "operation-execution-types.schema.json#/$defs/agentId"}
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {"$ref": "operation-execution-types.schema.json#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "safeText128": {"type": "string", "minLength": 1, "maxLength": 128},
    "safeText512": {"type": "string", "minLength": 1, "maxLength": 512},
    "nullableSafeText512": {
      "oneOf": [
        {"$ref": "#/$defs/safeText512"},
        {"type": "null"}
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/|~)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "source": {"enum": ["bundled", "user", "project", "plugin", "unknown"]},
    "lifecycle": {
      "enum": [
        "queued", "starting", "running", "waiting", "needs_approval", "blocked",
        "review_ready", "failed_validation", "runtime_failure", "cancelled", "unknown_outcome"
      ]
    },
    "projectScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "logical_project_key"],
      "properties": {
        "node_id": {"$ref": "operation-execution-types.schema.json#/$defs/identifier"},
        "logical_project_key": {"$ref": "operation-execution-types.schema.json#/$defs/identifier"}
      }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^operation-evidence-[0-9a-f]{48}$"}
    },
    "toolDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {"$ref": "#/$defs/safeText128"},
        "kind": {"enum": ["filesystem", "shell", "lsp", "subagent", "network", "other"]}
      }
    },
    "skillDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "source"],
      "properties": {
        "skill_id": {"$ref": "operation-execution-types.schema.json#/$defs/identifier"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "fileDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "action": {"enum": ["read", "created", "modified", "deleted", "renamed"]}
      }
    },
    "changeDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "additions", "deletions", "evidence_ref"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "action": {"enum": ["created", "modified", "deleted", "renamed"]},
        "additions": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "deletions": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "evidence_ref": {
          "oneOf": [
            {"type": "string", "pattern": "^operation-evidence-[0-9a-f]{48}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "approvalDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "state"],
      "properties": {
        "approval_id": {"$ref": "operation-execution-types.schema.json#/$defs/requestKey"},
        "state": {"enum": ["requested", "granted", "denied", "cancelled"]}
      }
    },
    "eventDetail": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/toolDetail"},
        {"$ref": "#/$defs/skillDetail"},
        {"$ref": "#/$defs/fileDetail"},
        {"$ref": "#/$defs/changeDetail"},
        {"$ref": "#/$defs/approvalDetail"}
      ]
    },
    "runtimeEventInput": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_id", "sequence", "kind", "status", "summary", "occurred_at", "detail"],
          "properties": {
            "event_id": {"$ref": "operation-execution-types.schema.json#/$defs/requestKey"},
            "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "kind": {"enum": ["activity", "tool", "skill", "file", "change", "approval"]},
            "status": {"enum": ["queued", "running", "succeeded", "failed", "blocked", "requested", "granted", "denied"]},
            "summary": {"$ref": "#/$defs/safeText512"},
            "occurred_at": {"type": "string", "format": "date-time"},
            "detail": {"$ref": "#/$defs/eventDetail"}
          }
        }
      ]
    },
    "runtimeEventProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sequence", "kind", "status", "summary", "occurred_at", "detail"],
      "properties": {
        "event_id": {"$ref": "#/$defs/runtimeEventId"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "kind": {"enum": ["activity", "tool", "skill", "file", "change", "approval"]},
        "status": {"enum": ["queued", "running", "succeeded", "failed", "blocked", "requested", "granted", "denied"]},
        "summary": {"$ref": "#/$defs/safeText512"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "detail": {"$ref": "#/$defs/eventDetail"}
      }
    },
    "structuredYield": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "evidence_refs"],
          "properties": {
            "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
            "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_id", "name", "status", "summary", "evidence_refs"],
      "properties": {
        "validation_id": {"$ref": "operation-execution-types.schema.json#/$defs/requestKey"},
        "name": {"$ref": "#/$defs/safeText128"},
        "status": {"enum": ["queued", "running", "passed", "failed", "blocked", "skipped"]},
        "summary": {"$ref": "#/$defs/nullableSafeText512"},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "runtimeError": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "summary", "retryable"],
          "properties": {
            "code": {"$ref": "operation-execution-types.schema.json#/$defs/identifier"},
            "summary": {"$ref": "#/$defs/safeText512"},
            "retryable": {"type": "boolean"}
          }
        }
      ]
    },
    "terminalResult": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summary", "evidence_refs"],
          "properties": {
            "status": {"enum": ["succeeded", "failed", "cancelled", "unknown"]},
            "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
            "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
          }
        }
      ]
    },
    "runtimeAgentUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_agent_ref", "parent_runtime_agent_ref", "parent_tool_call_ref", "runtime_session_ref",
        "agent_kind", "reported_name", "reported_role", "source", "project_scope", "lifecycle",
        "activity_summary", "event", "structured_yield", "validations", "error", "terminal_result"
      ],
      "properties": {
        "runtime_agent_ref": {"$ref": "#/$defs/opaqueRef"},
        "parent_runtime_agent_ref": {"$ref": "#/$defs/nullableOpaqueRef"},
        "parent_tool_call_ref": {"$ref": "#/$defs/nullableOpaqueRef"},
        "runtime_session_ref": {"$ref": "#/$defs/nullableOpaqueRef"},
        "agent_kind": {"enum": ["task_agent", "subagent"]},
        "reported_name": {"$ref": "#/$defs/safeText128"},
        "reported_role": {"$ref": "#/$defs/safeText128"},
        "source": {"$ref": "#/$defs/source"},
        "project_scope": {"$ref": "#/$defs/projectScope"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "activity_summary": {"$ref": "#/$defs/nullableSafeText512"},
        "event": {"$ref": "#/$defs/runtimeEventInput"},
        "structured_yield": {"$ref": "#/$defs/structuredYield"},
        "validations": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/validation"}},
        "error": {"$ref": "#/$defs/runtimeError"},
        "terminal_result": {"$ref": "#/$defs/terminalResult"}
      }
    },
    "parentProjection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "agent_id", "tool_call_ref_digest"],
          "properties": {
            "availability": {"const": "available"},
            "agent_id": {"$ref": "#/$defs/parentAgentId"},
            "tool_call_ref_digest": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "agent_id", "tool_call_ref_digest"],
          "properties": {
            "availability": {"const": "correlated"},
            "agent_id": {"type": "null"},
            "tool_call_ref_digest": {"$ref": "operation-execution-types.schema.json#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "agent_id", "tool_call_ref_digest"],
          "properties": {
            "availability": {"const": "unavailable"},
            "agent_id": {"type": "null"},
            "tool_call_ref_digest": {"type": "null"}
          }
        }
      ]
    },
    "runtimeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_ref_digest", "session_ref_digest"],
      "properties": {
        "agent_ref_digest": {"$ref": "operation-execution-types.schema.json#/$defs/sha256"},
        "session_ref_digest": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "runtimeAgentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id", "parent", "agent_kind", "reported_name", "reported_role", "source", "runtime",
        "project_scope", "lifecycle", "activity_summary", "events", "structured_yield", "validations",
        "error", "terminal_result", "created_at", "updated_at"
      ],
      "properties": {
        "agent_id": {"$ref": "#/$defs/runtimeAgentId"},
        "parent": {"$ref": "#/$defs/parentProjection"},
        "agent_kind": {"enum": ["task_agent", "subagent"]},
        "reported_name": {"$ref": "#/$defs/safeText128"},
        "reported_role": {"$ref": "#/$defs/safeText128"},
        "source": {"$ref": "#/$defs/source"},
        "runtime": {"$ref": "#/$defs/runtimeProjection"},
        "project_scope": {"$ref": "#/$defs/projectScope"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "activity_summary": {"$ref": "#/$defs/nullableSafeText512"},
        "events": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/runtimeEventProjection"}},
        "structured_yield": {"$ref": "#/$defs/structuredYield"},
        "validations": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/validation"}},
        "error": {"$ref": "#/$defs/runtimeError"},
        "terminal_result": {"$ref": "#/$defs/terminalResult"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
