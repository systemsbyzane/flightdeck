{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/mission-authoring-operation-result.schema.json",
  "title": "Flightdeck Mission authoring operation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "operation_id", "outcome", "mission_id", "plan_id", "reason"],
  "properties": {
    "schema_version": {"const": "flightdeck.mission-authoring.operation-result/v1"},
    "schema": {"const": "hub/schemas/mission-authoring-operation-result.schema.json"},
    "ok": {"const": true},
    "operation_id": {"$ref": "mission-authoring-types.schema.json#/$defs/operationId"},
    "outcome": {"enum": ["created", "not_created", "unresolved"]},
    "mission_id": {"type": ["string", "null"], "pattern": "^mission-[0-9a-f]{24}$"},
    "plan_id": {"type": ["string", "null"], "pattern": "^plan-[0-9a-f]{48}$"},
    "reason": {"type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 128}
  }
}
