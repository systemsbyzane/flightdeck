{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-execution-open-request.schema.json",
  "title": "Flightdeck Operation recovery request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "work_id",
    "operation_id",
    "execution_id"
  ],
  "properties": {
    "schema_version": {
      "const": "flightdeck.operation-execution.open-request/v1"
    },
    "adapter": {
      "$ref": "operation-execution-types.schema.json#/$defs/adapterDescriptor"
    },
    "work_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/workId"
    },
    "operation_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/operationId"
    },
    "execution_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/executionId"
    }
  }
}
