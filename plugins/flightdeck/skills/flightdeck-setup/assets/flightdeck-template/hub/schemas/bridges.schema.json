{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/bridges.schema.json",
  "title": "Bridge Registry",
  "type": "object",
  "required": ["api_version", "kind", "bridges"],
  "properties": {
    "api_version": {"const": "flightdeck.dev/v1alpha1"},
    "kind": {"const": "BridgeRegistry"},
    "bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository_id", "repository_root", "mode", "profile", "version", "target", "sha256", "artifacts", "hub_root", "installed_at"],
        "properties": {
          "repository_id": {"type": "string"},
          "repository_root": {"type": "string", "pattern": "^/"},
          "mode": {"enum": ["reference", "materialized", "repo-native"]},
          "profile": {"type": "string"},
          "version": {"type": "string"},
          "target": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "hub_root": {"type": "string", "pattern": "^/"},
          "installed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
