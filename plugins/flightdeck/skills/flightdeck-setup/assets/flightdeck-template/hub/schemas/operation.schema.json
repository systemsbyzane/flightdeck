{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation.schema.json",
  "title": "Flightdeck Operation Projection Contract",
  "description": "Versioned read-only projection of one managed Mission Operation. It excludes paths, runtime project IDs, prompt content, declarations, and untrusted child prose.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "kind", "schema", "ok", "operation"],
  "properties": {
    "api_version": {"const": "flightdeck.operation/v1"}, "kind": {"const": "Operation"},
    "schema": {"const": "hub/schemas/operation.schema.json"}, "ok": {"const": true},
    "operation": {"$ref": "#/$defs/operation"}
  },
  "$defs": {
    "id": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "skillItem": {"type": "object", "additionalProperties": false, "required": ["skill_id", "skill_version", "lifecycle_status"], "properties": {"skill_id": {"$ref": "#/$defs/id"}, "skill_version": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]}, "lifecycle_status": {"enum": ["started", "completed", "succeeded", "failed", "blocked", "unknown_outcome"]}}},
    "skills": {"type": "object", "additionalProperties": false, "required": ["state", "items"], "properties": {"state": {"enum": ["absent", "in_progress", "succeeded", "partial_failure"]}, "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/skillItem"}}}, "allOf": [{"if": {"properties": {"state": {"const": "absent"}}, "required": ["state"]}, "then": {"properties": {"items": {"maxItems": 0}}}}]},
    "operation": {"type": "object", "additionalProperties": false, "required": ["operation_id", "title", "mode", "state", "updated_at", "children"], "properties": {"operation_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1, "maxLength": 256}, "mode": {"enum": ["dispatch_only", "watch_only", "supervised"]}, "state": {"type": "string", "minLength": 1, "maxLength": 64}, "updated_at": {"type": "string", "format": "date-time"}, "children": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/child"}}}},
    "child": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "project", "state", "status_code", "session", "verified_skills", "files_changed", "output_refs"],
      "properties": {
        "node_id": {"$ref": "#/$defs/id"}, "project": {"type": "object", "additionalProperties": false, "required": ["logical_project_key"], "properties": {"logical_project_key": {"$ref": "#/$defs/id"}}},
        "state": {"type": "string", "minLength": 1, "maxLength": 64}, "status_code": {"type": ["string", "null"], "maxLength": 128},
        "session": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["state", "task_id"], "properties": {"state": {"const": "resolved"}, "task_id": {"type": "string", "minLength": 1, "maxLength": 512}}}, {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"enum": ["pending_identity", "unavailable"]}}}]},
        "verified_skills": {"$ref": "#/$defs/skills"},
        "files_changed": {"type": "object", "additionalProperties": false, "required": ["availability"], "properties": {"availability": {"const": "not_collected"}}},
        "output_refs": {"type": "array", "maxItems": 1000, "items": {"type": "string", "pattern": "^(artifact|codex-task):"}}
      }
    }
  }
}
