{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-detail-result.schema.json",
  "title": "Flightdeck Operation Detail Result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "operation"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-detail.result/v1"},
    "schema": {"const": "hub/schemas/operation-detail-result.schema.json"},
    "ok": {"const": true},
    "operation": {"$ref": "#/$defs/operation"}
  },
  "$defs": {
    "status": {"enum": ["queued", "working", "waiting", "approval_required", "blocked", "review_ready", "failed_validation", "cancelled", "reconcile_required"]},
    "unavailableEvidence": {"type": "object", "additionalProperties": false, "required": ["state", "items"], "properties": {"state": {"const": "unavailable"}, "items": {"type": "array", "maxItems": 0}}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["scope", "external_actions_authorized"], "properties": {"scope": {"const": "selected_projects_only"}, "external_actions_authorized": {"const": false}}},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["queued", "working", "waiting", "approval_required", "blocked", "review_ready", "failed_validation", "cancelled", "reconcile_required"],
      "properties": {"queued": {"type": "integer", "minimum": 0}, "working": {"type": "integer", "minimum": 0}, "waiting": {"type": "integer", "minimum": 0}, "approval_required": {"type": "integer", "minimum": 0}, "blocked": {"type": "integer", "minimum": 0}, "review_ready": {"type": "integer", "minimum": 0}, "failed_validation": {"type": "integer", "minimum": 0}, "cancelled": {"type": "integer", "minimum": 0}, "reconcile_required": {"type": "integer", "minimum": 0}}
    },
    "progress": {"type": "object", "additionalProperties": false, "required": ["total", "counts"], "properties": {"total": {"type": "integer", "minimum": 1, "maximum": 1000}, "counts": {"$ref": "#/$defs/counts"}}},
    "criterion": {"type": "object", "additionalProperties": false, "required": ["criterion", "disposition", "status_code"], "properties": {"criterion": {"type": "string", "minLength": 1, "maxLength": 1024}, "disposition": {"enum": ["passed", "failed", "blocked", "degraded"]}, "status_code": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "name", "project", "status", "activity", "observed_at", "validation", "changed_files", "skills"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1, "maxLength": 128}, "name": {"type": "string", "minLength": 1, "maxLength": 256}, "project": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"$ref": "#/$defs/status"}, "activity": {"type": ["string", "null"], "maxLength": 128}, "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "validation": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/criterion"}}, "changed_files": {"$ref": "#/$defs/unavailableEvidence"}, "skills": {"$ref": "#/$defs/unavailableEvidence"}
      }
    },
    "dependency": {"type": "object", "additionalProperties": false, "required": ["from_agent", "to_agent", "state"], "properties": {"from_agent": {"type": "string", "minLength": 1, "maxLength": 256}, "to_agent": {"type": "string", "minLength": 1, "maxLength": 256}, "state": {"$ref": "#/$defs/status"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["project", "type", "label"], "properties": {"project": {"type": "string", "minLength": 1, "maxLength": 256}, "type": {"type": "string", "minLength": 1, "maxLength": 128}, "label": {"type": ["string", "null"], "maxLength": 128}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["state", "items"], "properties": {"state": {"enum": ["available", "unavailable"]}, "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/artifact"}}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["project", "state", "summary"], "properties": {"project": {"type": "string", "minLength": 1, "maxLength": 256}, "state": {"const": "required"}, "summary": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "approvals": {"type": "object", "additionalProperties": false, "required": ["state", "items"], "properties": {"state": {"enum": ["none", "available"]}, "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/approval"}}}},
    "validationTotals": {"type": "object", "additionalProperties": false, "required": ["passed", "failed", "blocked", "degraded"], "properties": {"passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "blocked": {"type": "integer", "minimum": 0}, "degraded": {"type": "integer", "minimum": 0}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["state", "totals"], "properties": {"state": {"enum": ["available", "unavailable"]}, "totals": {"$ref": "#/$defs/validationTotals"}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["state", "summary"], "properties": {"state": {"enum": ["available", "unavailable"]}, "summary": {"type": ["string", "null"], "maxLength": 512}}},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "title", "status", "origin", "created_at", "updated_at", "goal", "mode", "authorization", "progress", "agents", "dependencies", "changes", "skills", "artifacts", "approvals", "validation", "result", "not_performed"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^operation-[0-9a-f]{24}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 256}, "status": {"$ref": "#/$defs/status"}, "origin": {"const": "work"},
        "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "goal": {"type": "string", "minLength": 1, "maxLength": 2048}, "mode": {"enum": ["dispatch_only", "watch_only", "supervised"]},
        "authorization": {"$ref": "#/$defs/authorization"}, "progress": {"$ref": "#/$defs/progress"}, "agents": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/agent"}},
        "dependencies": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/dependency"}}, "changes": {"$ref": "#/$defs/unavailableEvidence"}, "skills": {"$ref": "#/$defs/unavailableEvidence"},
        "artifacts": {"$ref": "#/$defs/artifacts"}, "approvals": {"$ref": "#/$defs/approvals"}, "validation": {"$ref": "#/$defs/validation"}, "result": {"$ref": "#/$defs/result"},
        "not_performed": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    }
  }
}
