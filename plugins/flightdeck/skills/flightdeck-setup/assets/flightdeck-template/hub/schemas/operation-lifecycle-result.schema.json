{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-lifecycle-result.schema.json",
  "title": "Flightdeck Operation Lifecycle Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "operation_id", "state", "archived", "completed_at", "archived_at", "replayed"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-lifecycle.result/v1"},
    "schema": {"const": "hub/schemas/operation-lifecycle-result.schema.json"},
    "ok": {"const": true},
    "operation_id": {"type": "string", "pattern": "^operation-[0-9a-f]{24}$"},
    "state": {"enum": ["review_ready", "completed", "failed_validation", "runtime_failure", "cancelled"]},
    "archived": {"type": "boolean"},
    "completed_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "archived_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "replayed": {"type": "boolean"}
  }
}
