{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/hub-compatibility.schema.json",
  "title": "Flightdeck generated-Hub compatibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema",
    "product",
    "template_version",
    "runtime_capabilities",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "flightdeck.hub-compatibility/v1"
    },
    "schema": {
      "const": "hub/schemas/hub-compatibility.schema.json"
    },
    "product": {
      "const": "flightdeck"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^flightdeck\\.(command|document)\\.[a-z0-9-]+\\.v[0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      }
    },
    "runtime_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_runtime", "adapters"],
      "properties": {
        "primary_runtime": {"const": "codex"},
        "adapters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codex", "omp"],
          "properties": {
            "codex": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available", "structured_channels", "optional_controls"],
              "properties": {
                "available": {"const": true},
                "structured_channels": {
                  "type": "array",
                  "const": ["flightdeck.runtime.work-recommendation/v1"]
                },
                "optional_controls": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"enum": ["model", "reasoning_effort"]}
                }
              }
            },
            "omp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available"],
              "properties": {"available": {"const": false}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description",
        "probe",
        "managed_paths",
        "fallback"
      ],
      "properties": {
        "kind": {
          "enum": [
            "command",
            "document"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "declaration_required": {
          "type": "boolean"
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "help_contains": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "conformance": {
              "const": "mission_sync_jit_worktree/v1"
            }
          },
          "oneOf": [
            {
              "required": [
                "help_contains"
              ]
            },
            {
              "required": [
                "path"
              ]
            }
          ]
        },
        "managed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "bundled_reference",
                "compatibility_report_only",
                "manual_exact_path_handoff",
                "stop_and_plan_migration"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "probe": {
                "required": [
                  "help_contains"
                ],
                "not": {
                  "required": [
                    "path"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "probe": {
                "required": [
                  "path"
                ],
                "not": {
                  "required": [
                    "help_contains"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fallback": {
                "properties": {
                  "mode": {
                    "const": "bundled_reference"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "document"
              },
              "fallback": {
                "required": [
                  "reference"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "fallback": {
                "not": {
                  "required": [
                    "reference"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
