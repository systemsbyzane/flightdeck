{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/hub-compatibility.schema.json",
  "title": "Flightdeck generated-Hub compatibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema",
    "product",
    "template_version",
    "runtime_capabilities",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "flightdeck.hub-compatibility/v1"
    },
    "schema": {
      "const": "hub/schemas/hub-compatibility.schema.json"
    },
    "product": {
      "const": "flightdeck"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^flightdeck\\.(command|document)\\.[a-z0-9-]+\\.v[0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      }
    },
    "runtime_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_runtime",
        "conversation",
        "operation_execution",
        "adapters"
      ],
      "properties": {
        "primary_runtime": {
          "const": "codex"
        },
        "conversation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter"],
          "properties": {"adapter": {"const": "codex"}}
        },
        "operation_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected_adapter", "execution_capability", "observation_capability"],
          "properties": {
            "selected_adapter": {"enum": ["omp", "codex_app_server"]},
            "execution_capability": {"const": "flightdeck.command.operation-execution.v1"},
            "observation_capability": {"const": "flightdeck.command.operation-observation.v1"}
          }
        },
        "adapters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codex", "omp", "codex_app_server"],
          "properties": {
            "codex": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available", "structured_channels", "optional_controls"],
              "properties": {
                "available": {"const": true},
                "structured_channels": {
                  "type": "array",
                  "const": ["flightdeck.runtime.work-recommendation/v1"]
                },
                "optional_controls": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"enum": ["model", "reasoning_effort"]}
                }
              }
            },
            "omp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "configuration_schema",
                "execution_capability",
                "observation_capability",
                "structured_channels",
                "optional_controls"
              ],
              "properties": {
                "available": {"type": "boolean"},
                "configuration_schema": {"const": "flightdeck.adapter.omp.configuration/v1"},
                "execution_capability": {"const": "flightdeck.command.operation-execution.v1"},
                "observation_capability": {"const": "flightdeck.command.operation-observation.v1"},
                "structured_channels": {
                  "type": "array",
                  "maxItems": 1,
                  "uniqueItems": true,
                  "items": {"const": "flightdeck.runtime.omp-operation-observation/v1"}
                },
                "optional_controls": {
                  "type": "array",
                  "const": ["model", "reasoning_effort", "tool_policy"]
                }
              },
              "allOf": [{
                "if": {"properties": {"available": {"const": true}}, "required": ["available"]},
                "then": {"properties": {"structured_channels": {"const": ["flightdeck.runtime.omp-operation-observation/v1"]}}},
                "else": {"properties": {"structured_channels": {"maxItems": 0}}}
              }]
            },
            "codex_app_server": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available", "configuration_schema", "execution_capability", "observation_capability", "structured_channels", "optional_controls"],
              "properties": {
                "available": {"type": "boolean"},
                "configuration_schema": {"const": "flightdeck.adapter.codex-app-server.configuration/v1"},
                "execution_capability": {"const": "flightdeck.command.operation-execution.v1"},
                "observation_capability": {"const": "flightdeck.command.operation-observation.v1"},
                "structured_channels": {
                  "type": "array",
                  "maxItems": 1,
                  "uniqueItems": true,
                  "items": {"const": "flightdeck.runtime.codex-app-server-operation-observation/v1"}
                },
                "optional_controls": {"type": "array", "const": ["model", "reasoning_effort", "tool_policy"]}
              },
              "allOf": [{
                "if": {"properties": {"available": {"const": true}}, "required": ["available"]},
                "then": {"properties": {"structured_channels": {"const": ["flightdeck.runtime.codex-app-server-operation-observation/v1"]}}},
                "else": {"properties": {"structured_channels": {"maxItems": 0}}}
              }]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"operation_execution": {"properties": {"selected_adapter": {"const": "omp"}}}}, "required": ["operation_execution"]},
          "then": {"properties": {"adapters": {"properties": {"omp": {"properties": {"available": {"const": true}}}}}}}
        },
        {
          "if": {"properties": {"operation_execution": {"properties": {"selected_adapter": {"const": "codex_app_server"}}}}, "required": ["operation_execution"]},
          "then": {"properties": {"adapters": {"properties": {"codex_app_server": {"properties": {"available": {"const": true}}}}}}}
        }
      ]
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description",
        "probe",
        "managed_paths",
        "fallback"
      ],
      "properties": {
        "kind": {
          "enum": [
            "command",
            "document"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "declaration_required": {
          "type": "boolean"
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "help_contains": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "conformance": {
              "const": "mission_sync_jit_worktree/v1"
            }
          },
          "oneOf": [
            {
              "required": [
                "help_contains"
              ]
            },
            {
              "required": [
                "path"
              ]
            }
          ]
        },
        "managed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "bundled_reference",
                "compatibility_report_only",
                "manual_exact_path_handoff",
                "stop_and_plan_migration"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "probe": {
                "required": [
                  "help_contains"
                ],
                "not": {
                  "required": [
                    "path"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "probe": {
                "required": [
                  "path"
                ],
                "not": {
                  "required": [
                    "help_contains"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fallback": {
                "properties": {
                  "mode": {
                    "const": "bundled_reference"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "document"
              },
              "fallback": {
                "required": [
                  "reference"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "fallback": {
                "not": {
                  "required": [
                    "reference"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
