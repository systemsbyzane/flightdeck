{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/mission-objective-snapshot-result.schema.json",
  "title": "Flightdeck Mission Objective Snapshot Result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "missions"],
  "properties": {
    "schema_version": {"const": "flightdeck.mission-objective.snapshot-result/v1"},
    "schema": {"const": "hub/schemas/mission-objective-snapshot-result.schema.json"},
    "ok": {"const": true},
    "missions": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/mission"}}
  },
  "$defs": {
    "status": {"enum": ["queued", "working", "waiting", "approval_required", "blocked", "review_ready", "failed_validation", "cancelled", "reconcile_required"]},
    "operation": {
      "type": "object", "additionalProperties": false, "required": ["operation_id", "order", "title", "status", "goal"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^operation-[0-9a-f]{24}$"}, "order": {"type": "integer", "minimum": 1, "maximum": 100},
        "title": {"type": "string", "minLength": 1, "maxLength": 256}, "status": {"$ref": "#/$defs/status"}, "goal": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "progress": {
      "type": "object", "additionalProperties": false, "required": ["total", "complete", "active", "waiting", "attention"],
      "properties": {"total": {"type": "integer", "minimum": 1, "maximum": 100}, "complete": {"type": "integer", "minimum": 0}, "active": {"type": "integer", "minimum": 0}, "waiting": {"type": "integer", "minimum": 0}, "attention": {"type": "integer", "minimum": 0}}
    },
    "mission": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_id", "title", "goal", "mode", "created_at", "updated_at", "state", "progress", "operations"],
      "properties": {
        "mission_id": {"type": "string", "pattern": "^mission-[0-9a-f]{24}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "goal": {"type": "string", "minLength": 1, "maxLength": 2048}, "mode": {"enum": ["watch_only", "supervised"]},
        "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"},
        "state": {"enum": ["planned", "waiting", "working", "needs_approval", "blocked", "failed_validation", "complete"]},
        "progress": {"$ref": "#/$defs/progress"}, "operations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/operation"}}
      }
    }
  }
}
