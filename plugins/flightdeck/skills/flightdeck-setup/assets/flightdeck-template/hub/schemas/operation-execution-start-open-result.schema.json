{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-execution-start-open-result.schema.json",
  "title": "Flightdeck durable agent start recovery result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "capability", "adapter", "work_id", "operation_id", "execution_id", "agent_id", "binding_state", "recovery", "failures"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-execution.start-open-result/v1"},
    "schema": {"const": "hub/schemas/operation-execution-start-open-result.schema.json"},
    "ok": {"const": true},
    "capability": {"const": "flightdeck.command.operation-start-recovery.v1"},
    "adapter": {"$ref": "operation-execution-types.schema.json#/$defs/adapterDescriptor"},
    "work_id": {"$ref": "operation-execution-types.schema.json#/$defs/workId"},
    "operation_id": {"$ref": "operation-execution-types.schema.json#/$defs/operationId"},
    "execution_id": {"$ref": "operation-execution-types.schema.json#/$defs/executionId"},
    "agent_id": {"$ref": "operation-execution-types.schema.json#/$defs/agentId"},
    "binding_state": {"enum": ["unbound", "bound"]},
    "recovery": {"$ref": "operation-execution-types.schema.json#/$defs/startRecovery"},
    "failures": {"type": "array", "maxItems": 8, "items": {"$ref": "operation-execution-types.schema.json#/$defs/startFailure"}}
  }
}
