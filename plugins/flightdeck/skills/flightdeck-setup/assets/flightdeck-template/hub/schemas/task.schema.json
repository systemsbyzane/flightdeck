{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/task.schema.json",
  "title": "Flightdeck Task Record",
  "description": "Canonical, resumable task state shared by every Flightdeck workflow adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec", "status"],
  "properties": {
    "api_version": {"const": "flightdeck.dev/v1alpha1"},
    "kind": {"const": "TaskRecord"},
    "schema": {"const": "hub/schemas/task.schema.json"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "created_at", "updated_at"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "created_by": {"type": "string", "minLength": 1},
        "labels": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "workload_id",
        "outcome",
        "scope",
        "authorization",
        "execution",
        "policies"
      ],
      "properties": {
        "type": {
          "enum": [
            "patching",
            "research",
            "development",
            "charts",
            "daily-ops",
            "compliance"
          ]
        },
        "workload_id": {
          "oneOf": [
            {"$ref": "#/$defs/id"},
            {"type": "null"}
          ]
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "success_criteria"],
          "properties": {
            "description": {"type": "string", "minLength": 1},
            "success_criteria": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "non_goals": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets"],
          "properties": {
            "targets": {
              "type": "array",
              "items": {"$ref": "#/$defs/target"}
            },
            "paths": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "environments": {
              "type": "array",
              "items": {"$ref": "#/$defs/id"},
              "uniqueItems": true
            },
            "external_sources": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actions"],
          "properties": {
            "actions": {
              "type": "array",
              "items": {"$ref": "#/$defs/authorizedAction"}
            },
            "notes": {"type": "string"}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context", "implementation_mode"],
          "properties": {
            "context": {
              "enum": [
                "hub",
                "repository_project",
                "repository_worktree",
                "program_workspace",
                "github",
                "remote_environment",
                "web_or_connector"
              ]
            },
            "implementation_mode": {"enum": ["none", "local", "worktree"]},
            "restore_validation_environment": {"type": "boolean"},
            "source_preference": {"type": "string", "minLength": 1},
            "freshness_required": {"type": "boolean"},
            "output_mode": {"type": "string", "minLength": 1},
            "backend_is_authorization_boundary": {"type": "boolean"},
            "author_reviewer_separation": {"type": "boolean"}
          }
        },
        "policies": {
          "type": "object",
          "required": ["commit", "push", "pull_request"],
          "additionalProperties": {"$ref": "#/$defs/policy"},
          "properties": {
            "commit": {"$ref": "#/$defs/policy"},
            "push": {"$ref": "#/$defs/policy"},
            "pull_request": {"$ref": "#/$defs/policy"},
            "mutation": {"$ref": "#/$defs/policy"},
            "cluster_mutation": {"$ref": "#/$defs/policy"},
            "external_submission": {"$ref": "#/$defs/policy"},
            "assertion": {"$ref": "#/$defs/policy"}
          }
        },
        "dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "evidence_plan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required_categories": {
              "type": "array",
              "items": {"$ref": "#/$defs/id"},
              "uniqueItems": true
            },
            "notes": {"type": "string"}
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "history", "evidence", "blockers"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/historyEntry"}
        },
        "units": {
          "type": "array",
          "items": {"$ref": "#/$defs/executionUnit"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/check"}
        },
        "approvals": {
          "type": "array",
          "items": {"$ref": "#/$defs/approval"}
        },
        "risks": {
          "type": "array",
          "items": {"$ref": "#/$defs/risk"}
        },
        "blockers": {
          "type": "array",
          "items": {"$ref": "#/$defs/blocker"}
        },
        "gates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"enum": ["pending", "passed", "failed", "waived"]},
              "checked_at": {"type": "string", "format": "date-time"},
              "note": {"type": "string"}
            }
          }
        },
        "summary": {"type": "string"}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "runtimeProjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Opaque Codex runtime projectId captured from an exact-path live-list match."
    },
    "state": {
      "enum": [
        "intake",
        "scoped",
        "designed",
        "authorized",
        "executing",
        "integration_ready",
        "validation_ready",
        "validating",
        "review_ready",
        "closed",
        "blocked",
        "cancelled",
        "rollback_required"
      ]
    },
    "policy": {
      "enum": [
        "automatic",
        "automatic_when_connected",
        "task_authorization",
        "explicit_user_authorization",
        "explicit_human_approval",
        "explicit_human_authority",
        "evidence_required",
        "prohibited"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "enum": ["workload", "repository", "path", "image", "environment", "program", "external_source"]
        },
        "name": {"type": "string", "minLength": 1},
        "repository_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "mutable": {"type": "boolean"}
      }
    },
    "authorizedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "policy"],
      "properties": {
        "action": {"$ref": "#/$defs/id"},
        "policy": {"$ref": "#/$defs/policy"},
        "scope": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "event", "from", "to"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "event": {"enum": ["created", "transitioned", "resumed", "blocked", "cancelled", "reopened"]},
        "from": {
          "oneOf": [
            {"$ref": "#/$defs/state"},
            {"type": "null"}
          ]
        },
        "to": {"$ref": "#/$defs/state"},
        "actor": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "executionUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "context", "state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"$ref": "#/$defs/id"},
        "context": {
          "enum": [
            "hub",
            "repository_project",
            "repository_worktree",
            "github",
            "remote_environment",
            "program_workspace",
            "web_or_connector",
            "external_system"
          ]
        },
        "state": {"enum": ["pending", "running", "completed", "failed", "blocked", "cancelled"]},
        "repository_id": {"$ref": "#/$defs/id"},
        "logical_project_key": {"$ref": "#/$defs/id"},
        "runtime_project_id": {"$ref": "#/$defs/runtimeProjectId"},
        "environment_id": {"$ref": "#/$defs/id"},
        "task_or_thread_id": {"type": "string", "minLength": 1},
        "starting_ref": {"type": "string", "minLength": 1},
        "starting_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "candidate_ref": {"type": "string", "minLength": 1},
        "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "summary": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "description", "state", "recorded_at"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "category": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1},
        "state": {
          "enum": [
            "available",
            "externally_accessible",
            "externally_held",
            "requested",
            "inaccessible",
            "missing"
          ]
        },
        "classification": {"enum": ["observed_fact", "inference", "assumption", "unknown"]},
        "source_kind": {
          "enum": [
            "repo_file",
            "command_output",
            "test_result",
            "scan_artifact",
            "build_artifact",
            "runtime_observation",
            "web_source",
            "connected_source",
            "external_reference",
            "user_statement",
            "document"
          ]
        },
        "reference": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "observed_at": {"type": "string", "format": "date-time"},
        "supports": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["pending", "passed", "failed", "skipped", "unavailable"]},
        "command": {"type": "string"},
        "reference": {"type": "string"},
        "checked_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status"],
      "properties": {
        "gate": {"$ref": "#/$defs/id"},
        "status": {"enum": ["pending", "approved", "rejected", "not_required"]},
        "decided_by": {"type": "string", "minLength": 1},
        "decided_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["approved", "rejected"]}}},
          "then": {"required": ["decided_by", "decided_at"]}
        }
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "severity", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "status": {"enum": ["open", "mitigated", "accepted", "transferred"]},
        "owner": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "resolved"]},
        "owner": {"type": "string", "minLength": 1},
        "resolution": {"type": "string"}
      }
    }
  }
}
