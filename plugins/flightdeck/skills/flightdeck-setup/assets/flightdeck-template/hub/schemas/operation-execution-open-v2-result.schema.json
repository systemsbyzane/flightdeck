{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-execution-open-v2-result.schema.json",
  "title": "Renderer-safe Operation recovery with runtime-agent hierarchy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "capability", "adapter", "work_id", "operation_id", "execution", "authorization", "runtime_boundary", "progress", "agents"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-execution.open-result/v2"},
    "schema": {"const": "hub/schemas/operation-execution-open-v2-result.schema.json"},
    "ok": {"const": true},
    "capability": {"const": "flightdeck.command.operation-agent-telemetry.v1"},
    "adapter": {"$ref": "operation-execution-types.schema.json#/$defs/adapterDescriptor"},
    "work_id": {"$ref": "operation-execution-types.schema.json#/$defs/workId"},
    "operation_id": {"$ref": "operation-execution-types.schema.json#/$defs/operationId"},
    "execution": {"$ref": "operation-execution-types.schema.json#/$defs/executionIdentity"},
    "authorization": {"$ref": "operation-execution-types.schema.json#/$defs/authorizationBinding"},
    "runtime_boundary": {"$ref": "operation-execution-types.schema.json#/$defs/runtimeBoundary"},
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "attention_required", "terminal"],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queued", "starting", "running", "waiting", "needs_approval", "blocked", "review_ready", "failed_validation", "runtime_failure", "cancelled", "unknown_outcome", "unobserved"],
          "properties": {
            "queued": {"type": "integer", "minimum": 0},
            "starting": {"type": "integer", "minimum": 0},
            "running": {"type": "integer", "minimum": 0},
            "waiting": {"type": "integer", "minimum": 0},
            "needs_approval": {"type": "integer", "minimum": 0},
            "blocked": {"type": "integer", "minimum": 0},
            "review_ready": {"type": "integer", "minimum": 0},
            "failed_validation": {"type": "integer", "minimum": 0},
            "runtime_failure": {"type": "integer", "minimum": 0},
            "cancelled": {"type": "integer", "minimum": 0},
            "unknown_outcome": {"type": "integer", "minimum": 0},
            "unobserved": {"type": "integer", "minimum": 0}
          }
        },
        "attention_required": {"type": "integer", "minimum": 0},
        "terminal": {"type": "integer", "minimum": 0}
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "operation-execution-observe-v2-result.schema.json#/$defs/safeAgent"}
    }
  }
}
