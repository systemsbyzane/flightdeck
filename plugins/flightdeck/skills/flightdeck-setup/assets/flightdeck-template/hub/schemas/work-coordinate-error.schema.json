{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/work-coordinate-error.schema.json",
  "title": "Flightdeck Work Coordinate Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "error"],
  "properties": {
    "schema_version": {"const": "flightdeck.work.coordinate-error/v1"},
    "schema": {"const": "hub/schemas/work-coordinate-error.schema.json"},
    "ok": {"const": false},
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["malformed_request", "unsupported_hub_contract", "operation_not_found", "unknown_outcome", "operation_identity_conflict", "terminal_operation", "guidance_limit_exceeded", "internal_error"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
