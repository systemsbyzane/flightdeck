{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-execution-bind-request.schema.json",
  "title": "Flightdeck Operation execution agent bind request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "work_id",
    "operation_id",
    "execution_id",
    "execution_generation",
    "execution_digest",
    "agent_id",
    "binding_idempotency_key",
    "adapter_session_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "flightdeck.operation-execution.bind-request/v1"
    },
    "adapter": {
      "$ref": "operation-execution-types.schema.json#/$defs/adapterDescriptor"
    },
    "work_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/workId"
    },
    "operation_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/operationId"
    },
    "execution_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/executionId"
    },
    "execution_generation": {
      "$ref": "operation-execution-types.schema.json#/$defs/executionGeneration"
    },
    "execution_digest": {
      "$ref": "operation-execution-types.schema.json#/$defs/sha256"
    },
    "agent_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/agentId"
    },
    "binding_idempotency_key": {
      "$ref": "operation-execution-types.schema.json#/$defs/requestKey"
    },
    "adapter_session_ref": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,511}$"
    }
  }
}
