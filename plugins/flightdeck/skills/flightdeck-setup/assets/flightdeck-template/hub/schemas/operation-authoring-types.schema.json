{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-authoring-types.schema.json",
  "title": "Flightdeck Operation authoring shared types",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 128},
    "operationId": {"type": "string", "pattern": "^operation-[0-9a-f]{24}$"},
    "opaque": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "boundedText": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]+$"},
    "targetIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_project_key", "runtime_project_id", "project_path_digest", "host_id", "execution_mode", "access_mode"],
      "properties": {
        "logical_project_key": {"$ref": "#/$defs/id"}, "runtime_project_id": {"$ref": "#/$defs/opaque"},
        "project_path_digest": {"$ref": "#/$defs/sha256"}, "host_id": {"$ref": "#/$defs/opaque"},
        "execution_mode": {"enum": ["local", "worktree"]}, "access_mode": {"enum": ["read_only", "write"]}
      }
    },
    "catalogTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "logical_project_key", "runtime_project_id", "project_path_digest", "host_id", "execution_mode", "access_mode", "display_label"],
      "properties": {
        "target_id": {"$ref": "#/$defs/id"}, "logical_project_key": {"$ref": "#/$defs/id"}, "runtime_project_id": {"$ref": "#/$defs/opaque"},
        "project_path_digest": {"$ref": "#/$defs/sha256"}, "host_id": {"$ref": "#/$defs/opaque"}, "execution_mode": {"enum": ["local", "worktree"]},
        "access_mode": {"enum": ["read_only", "write"]}, "display_label": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "selectedTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "logical_project_key", "runtime_project_id", "project_path_digest", "host_id", "execution_mode", "access_mode"],
      "properties": {
        "target_id": {"$ref": "#/$defs/id"}, "logical_project_key": {"$ref": "#/$defs/id"}, "runtime_project_id": {"$ref": "#/$defs/opaque"},
        "project_path_digest": {"$ref": "#/$defs/sha256"}, "host_id": {"$ref": "#/$defs/opaque"}, "execution_mode": {"enum": ["local", "worktree"]}, "access_mode": {"enum": ["read_only", "write"]}
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "work_intent", "success_criteria", "non_goals", "mode", "selected_targets"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 256}, "work_intent": {"type": "string", "minLength": 1, "maxLength": 2048},
        "success_criteria": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedText"}},
        "non_goals": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedText"}},
        "mode": {"enum": ["dispatch_only", "watch_only", "supervised"]},
        "selected_targets": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/selectedTarget"}}
      }
    },
    "confirmation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "plan_id", "plan_generation", "plan_digest", "plan_token"],
      "properties": {"operation_id": {"$ref": "#/$defs/operationId"}, "plan_id": {"type": "string", "pattern": "^plan-[0-9a-f]{48}$"}, "plan_generation": {"type": "string", "pattern": "^generation-[0-9a-f]{48}$"}, "plan_digest": {"$ref": "#/$defs/sha256"}, "plan_token": {"$ref": "#/$defs/sha256"}}
    },
    "criterion": {"type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/boundedText"}}},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_id", "snapshot_operation_id", "title", "work_intent", "mode", "success_criteria", "non_goals", "authorized_targets", "authorization_boundary", "nodes"],
      "properties": {
        "mission_id": {"$ref": "#/$defs/operationId"}, "snapshot_operation_id": {"type": "string", "pattern": "^mission:operation-[0-9a-f]{24}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256}, "work_intent": {"type": "string", "minLength": 1, "maxLength": 2048}, "mode": {"enum": ["dispatch_only", "watch_only", "supervised"]},
        "success_criteria": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/criterion"}}, "non_goals": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/boundedText"}},
        "authorized_targets": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/targetIdentity"}}, "authorization_boundary": {"$ref": "#/$defs/id"},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["id", "logical_project_key", "runtime_project_id", "project_path_digest", "host_id", "execution_mode", "access_mode", "work_type", "required", "dependencies", "accepted_input_types", "allowed_output_types", "criterion_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "logical_project_key": {"$ref": "#/$defs/id"}, "runtime_project_id": {"$ref": "#/$defs/opaque"}, "project_path_digest": {"$ref": "#/$defs/sha256"}, "host_id": {"$ref": "#/$defs/opaque"}, "execution_mode": {"enum": ["local", "worktree"]}, "access_mode": {"enum": ["read_only", "write"]}, "work_type": {"enum": ["implementation", "research", "review"]}, "required": {"type": "boolean"}, "dependencies": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "accepted_input_types": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "allowed_output_types": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "criterion_ids": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/id"}}}}}
      }
    },
    "warning": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"$ref": "#/$defs/id"}, "message": {"type": "string", "minLength": 1, "maxLength": 1024}}},
    "errorCode": {"enum": ["malformed_request", "future_version", "unsupported_version", "unsupported_hub_contract", "capability_incomplete", "catalog_invalid", "ineligible_target", "stale_or_mismatched_plan", "conflicting_operation", "unknown_outcome", "persistence_failed", "not_created", "operation_not_found", "operation_store_invalid", "operation_identity_conflict", "terminal_operation", "guidance_limit_exceeded", "forbidden_content", "internal_error"]}
  }
}
