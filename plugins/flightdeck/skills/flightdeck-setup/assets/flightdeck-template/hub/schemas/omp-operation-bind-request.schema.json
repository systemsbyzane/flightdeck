{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://flightdeck.dev/schemas/omp-operation-bind-request.schema.json", "title": "Flightdeck OMP agent bind request", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "work_id", "operation_id", "execution_id", "execution_generation", "execution_digest", "agent_id", "binding_idempotency_key", "omp_session_ref"],
  "properties": {"schema_version": {"const": "flightdeck.omp-operation.bind-request/v1"}, "work_id": {"$ref": "omp-operation-types.schema.json#/$defs/workId"}, "operation_id": {"$ref": "omp-operation-types.schema.json#/$defs/operationId"}, "execution_id": {"$ref": "omp-operation-types.schema.json#/$defs/executionId"}, "execution_generation": {"$ref": "omp-operation-types.schema.json#/$defs/executionGeneration"}, "execution_digest": {"$ref": "omp-operation-types.schema.json#/$defs/sha256"}, "agent_id": {"$ref": "omp-operation-types.schema.json#/$defs/agentId"}, "binding_idempotency_key": {"$ref": "omp-operation-types.schema.json#/$defs/requestKey"}, "omp_session_ref": {"type": "string", "minLength": 8, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,511}$"}}
}
