{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-detail-v2-result.schema.json",
  "title": "Flightdeck Operation Detail v2 Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "operation"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-detail.result/v2"},
    "schema": {"const": "hub/schemas/operation-detail-v2-result.schema.json"},
    "ok": {"const": true},
    "operation": {"$ref": "#/$defs/operation"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 128},
    "operationId": {"type": "string", "pattern": "^operation-[0-9a-f]{24}$"},
    "agentId": {"type": "string", "pattern": "^flightdeck-agent-[0-9a-f]{48}$"},
    "evidenceRef": {"type": "string", "pattern": "^operation-evidence-[0-9a-f]{48}$"},
    "availability": {"enum": ["available", "unavailable"]},
    "lifecycle": {"enum": ["queued", "starting", "working", "waiting", "approval_required", "review_ready", "completed", "failed", "needs_recovery", "stalled", "cancelled"]},
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["kind", "status"],
      "properties": {"kind": {"enum": ["filesystem", "shell", "lsp", "subagent", "network", "other"]}, "status": {"enum": ["queued", "running", "succeeded", "failed", "blocked"]}}
    },
    "subagents": {
      "type": "object", "additionalProperties": false, "required": ["active", "completed", "failed", "blocked"],
      "properties": {"active": {"type": "integer", "minimum": 0, "maximum": 1000}, "completed": {"type": "integer", "minimum": 0, "maximum": 1000}, "failed": {"type": "integer", "minimum": 0, "maximum": 1000}, "blocked": {"type": "integer", "minimum": 0, "maximum": 1000}}
    },
    "attention": {
      "type": "object", "additionalProperties": false, "required": ["required", "code"],
      "properties": {"required": {"type": "boolean"}, "code": {"type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 128}}
    },
    "unavailableItems": {
      "type": "object", "additionalProperties": false, "required": ["availability", "items"],
      "properties": {"availability": {"const": "unavailable"}, "items": {"type": "array", "maxItems": 0}}
    },
    "activity": {
      "type": "object", "additionalProperties": false, "required": ["availability", "action_summary", "tool", "observed_at"],
      "properties": {
        "availability": {"$ref": "#/$defs/availability"},
        "action_summary": {"type": ["string", "null"], "maxLength": 512},
        "tool": {"oneOf": [{"$ref": "#/$defs/tool"}, {"type": "null"}]},
        "observed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["availability", "sequence", "lifecycle", "observed_at", "tool", "subagents", "attention", "error_code"],
      "properties": {
        "availability": {"$ref": "#/$defs/availability"},
        "sequence": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000},
        "lifecycle": {"type": ["string", "null"], "enum": [null, "queued", "starting", "running", "waiting", "needs_approval", "blocked", "review_ready", "failed_validation", "runtime_failure", "cancelled", "unknown_outcome"]},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "tool": {"oneOf": [{"$ref": "#/$defs/tool"}, {"type": "null"}]},
        "subagents": {"oneOf": [{"$ref": "#/$defs/subagents"}, {"type": "null"}]},
        "attention": {"oneOf": [{"$ref": "#/$defs/attention"}, {"type": "null"}]},
        "error_code": {"type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 128}
      }
    },
    "validationItem": {
      "type": "object", "additionalProperties": false, "required": ["criterion_id", "disposition", "status_code"],
      "properties": {"criterion_id": {"$ref": "#/$defs/id"}, "disposition": {"enum": ["passed", "failed", "blocked", "degraded"]}, "status_code": {"$ref": "#/$defs/id"}}
    },
    "validation": {
      "type": "object", "additionalProperties": false, "required": ["availability", "items"],
      "properties": {"availability": {"$ref": "#/$defs/availability"}, "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/validationItem"}}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["kind", "reference", "label"],
      "properties": {"kind": {"enum": ["declared_output", "evidence"]}, "reference": {"type": ["string", "null"], "maxLength": 128}, "label": {"type": ["string", "null"], "maxLength": 128}}
    },
    "artifacts": {
      "type": "object", "additionalProperties": false, "required": ["availability", "items"],
      "properties": {"availability": {"$ref": "#/$defs/availability"}, "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/artifact"}}}
    },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["state", "code", "summary"],
      "properties": {"state": {"const": "required"}, "code": {"type": ["string", "null"], "maxLength": 128}, "summary": {"type": "string", "minLength": 1, "maxLength": 256}}
    },
    "approvals": {
      "type": "object", "additionalProperties": false, "required": ["availability", "items"],
      "properties": {"availability": {"$ref": "#/$defs/availability"}, "items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/approval"}}}
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["availability", "summary", "evidence_refs"],
      "properties": {"availability": {"$ref": "#/$defs/availability"}, "summary": {"type": ["string", "null"], "maxLength": 2048}, "evidence_refs": {"type": "array", "maxItems": 2500, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}}
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "node_id", "name", "logical_project_key", "project", "role", "dependencies", "execution_order", "lifecycle", "binding", "current_activity", "last_observation", "validation", "checks", "changes", "artifacts", "approvals", "result"],
      "properties": {
        "agent_id": {"oneOf": [{"$ref": "#/$defs/agentId"}, {"type": "null"}]},
        "node_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "logical_project_key": {"$ref": "#/$defs/id"}, "project": {"type": "string", "minLength": 1, "maxLength": 256}, "role": {"type": "string", "minLength": 1, "maxLength": 128},
        "dependencies": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "execution_order": {"type": ["integer", "null"], "minimum": 0, "maximum": 49},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "binding": {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"enum": ["unavailable", "unbound", "bound"]}}},
        "current_activity": {"$ref": "#/$defs/activity"}, "last_observation": {"$ref": "#/$defs/observation"},
        "validation": {"$ref": "#/$defs/validation"}, "checks": {"$ref": "#/$defs/unavailableItems"}, "changes": {"$ref": "#/$defs/unavailableItems"},
        "artifacts": {"$ref": "#/$defs/artifacts"}, "approvals": {"$ref": "#/$defs/approvals"}, "result": {"$ref": "#/$defs/result"}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false, "required": ["logical_project_key", "display_name", "execution_mode", "access_mode", "work_type"],
      "properties": {"logical_project_key": {"$ref": "#/$defs/id"}, "display_name": {"type": "string", "minLength": 1, "maxLength": 256}, "execution_mode": {"enum": ["local", "worktree"]}, "access_mode": {"enum": ["read_only", "write"]}, "work_type": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "criterion": {
      "type": "object", "additionalProperties": false, "required": ["criterion_id", "summary", "assigned_node_ids", "assigned_agent_ids", "disposition"],
      "properties": {"criterion_id": {"$ref": "#/$defs/id"}, "summary": {"type": "string", "minLength": 1, "maxLength": 1024}, "assigned_node_ids": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/id"}}, "assigned_agent_ids": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/agentId"}}, "disposition": {"type": ["string", "null"], "enum": [null, "passed", "failed", "blocked", "degraded"]}}
    },
    "dependency": {"type": "object", "additionalProperties": false, "required": ["from_node_id", "to_node_id"], "properties": {"from_node_id": {"$ref": "#/$defs/id"}, "to_node_id": {"$ref": "#/$defs/id"}}},
    "progress": {
      "type": "object", "additionalProperties": false, "required": ["total", "counts"],
      "properties": {
        "total": {"type": "integer", "minimum": 1, "maximum": 50},
        "counts": {"type": "object", "additionalProperties": false, "required": ["queued", "starting", "working", "waiting", "approval_required", "review_ready", "completed", "failed", "needs_recovery", "stalled", "cancelled"], "properties": {"queued": {"type": "integer", "minimum": 0}, "starting": {"type": "integer", "minimum": 0}, "working": {"type": "integer", "minimum": 0}, "waiting": {"type": "integer", "minimum": 0}, "approval_required": {"type": "integer", "minimum": 0}, "review_ready": {"type": "integer", "minimum": 0}, "completed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "needs_recovery": {"type": "integer", "minimum": 0}, "stalled": {"type": "integer", "minimum": 0}, "cancelled": {"type": "integer", "minimum": 0}}}
      }
    },
    "evidence": {"type": "object", "additionalProperties": false, "required": ["availability", "references"], "properties": {"availability": {"$ref": "#/$defs/availability"}, "references": {"type": "array", "maxItems": 2500, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "classification", "source", "title", "status", "timestamps", "goal", "mode", "project_scope", "authorization", "heartbeat", "success_criteria", "progress", "agents", "dependencies", "validation", "checks", "changes", "artifacts", "approvals", "evidence", "result", "not_performed"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/operationId"}, "classification": {"const": "authored_operation"},
        "source": {"type": "object", "additionalProperties": false, "required": ["kind", "source_id"], "properties": {"kind": {"const": "mission_record"}, "source_id": {"type": "string", "pattern": "^mission:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$", "maxLength": 136}}},
        "title": {"type": "string", "minLength": 1, "maxLength": 256}, "status": {"$ref": "#/$defs/lifecycle"},
        "timestamps": {"type": "object", "additionalProperties": false, "required": ["created_at", "updated_at", "last_observed_at"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "last_observed_at": {"type": ["string", "null"], "format": "date-time"}}},
        "goal": {"type": "string", "minLength": 1, "maxLength": 2048}, "mode": {"enum": ["dispatch_only", "watch_only", "supervised"]},
        "project_scope": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/project"}},
        "authorization": {"type": "object", "additionalProperties": false, "required": ["scope", "boundary_id", "external_actions_authorized"], "properties": {"scope": {"const": "selected_projects_only"}, "boundary_id": {"$ref": "#/$defs/id"}, "external_actions_authorized": {"const": false}}},
        "heartbeat": {"type": "object", "additionalProperties": false, "required": ["stale_after_seconds"], "properties": {"stale_after_seconds": {"type": "integer", "minimum": 1, "maximum": 604800}}},
        "success_criteria": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/criterion"}},
        "progress": {"$ref": "#/$defs/progress"}, "agents": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/agent"}},
        "dependencies": {"type": "array", "maxItems": 2500, "items": {"$ref": "#/$defs/dependency"}},
        "validation": {"$ref": "#/$defs/validation"}, "checks": {"$ref": "#/$defs/unavailableItems"}, "changes": {"$ref": "#/$defs/unavailableItems"},
        "artifacts": {"$ref": "#/$defs/artifacts"}, "approvals": {"$ref": "#/$defs/approvals"}, "evidence": {"$ref": "#/$defs/evidence"}, "result": {"$ref": "#/$defs/result"},
        "not_performed": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    }
  }
}
