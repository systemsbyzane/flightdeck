{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-execution-start-report-request.schema.json",
  "title": "Flightdeck pre-bind agent start failure report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter", "work_id", "operation_id", "execution_id", "execution_generation", "execution_digest", "agent_id", "dispatch_generation", "dispatch_id", "runtime_project_id", "retry_generation", "report_id", "failure"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-execution.start-report-request/v1"},
    "adapter": {"$ref": "operation-execution-types.schema.json#/$defs/adapterDescriptor"},
    "work_id": {"$ref": "operation-execution-types.schema.json#/$defs/workId"},
    "operation_id": {"$ref": "operation-execution-types.schema.json#/$defs/operationId"},
    "execution_id": {"$ref": "operation-execution-types.schema.json#/$defs/executionId"},
    "execution_generation": {"$ref": "operation-execution-types.schema.json#/$defs/executionGeneration"},
    "execution_digest": {"$ref": "operation-execution-types.schema.json#/$defs/sha256"},
    "agent_id": {"$ref": "operation-execution-types.schema.json#/$defs/agentId"},
    "dispatch_generation": {"$ref": "operation-execution-types.schema.json#/$defs/dispatchGeneration"},
    "dispatch_id": {"$ref": "operation-execution-types.schema.json#/$defs/dispatchId"},
    "runtime_project_id": {"$ref": "operation-execution-types.schema.json#/$defs/runtimeProjectId"},
    "retry_generation": {"oneOf": [{"$ref": "operation-execution-types.schema.json#/$defs/retryGeneration"}, {"type": "null"}]},
    "report_id": {"$ref": "operation-execution-types.schema.json#/$defs/requestKey"},
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary", "retryable", "failed_at"],
      "properties": {
        "code": {"$ref": "operation-execution-types.schema.json#/$defs/identifier"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512},
        "retryable": {"type": "boolean"},
        "failed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
