{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://flightdeck.dev/schemas/omp-operation-execution-plan-result.schema.json",
  "title": "Flightdeck native-only OMP Operation execution plan result", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "capability", "work_id", "operation_id", "execution", "authorization", "runtime_boundary", "policy", "agents", "replayed"],
  "properties": {
    "schema_version": {"const": "flightdeck.omp-operation.execution-plan-result/v1"}, "schema": {"const": "hub/schemas/omp-operation-execution-plan-result.schema.json"}, "ok": {"const": true}, "capability": {"const": "flightdeck.command.omp-operation-execution.v1"},
    "work_id": {"$ref": "omp-operation-types.schema.json#/$defs/workId"}, "operation_id": {"$ref": "omp-operation-types.schema.json#/$defs/operationId"}, "execution": {"$ref": "omp-operation-types.schema.json#/$defs/executionIdentity"}, "authorization": {"$ref": "omp-operation-types.schema.json#/$defs/authorizationBinding"}, "runtime_boundary": {"$ref": "omp-operation-types.schema.json#/$defs/runtimeBoundary"},
    "policy": {"type": "object", "additionalProperties": false, "required": ["strategy", "max_concurrency"], "properties": {"strategy": {"const": "parallel_independent"}, "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 8}}},
    "agents": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["agent_id", "node_id", "logical_project_key", "dependencies", "execution_order", "authorized_task", "requested_model", "reasoning_effort", "tool_policy", "native_authorization", "binding_state"], "properties": {"agent_id": {"$ref": "omp-operation-types.schema.json#/$defs/agentId"}, "node_id": {"$ref": "omp-operation-types.schema.json#/$defs/identifier"}, "logical_project_key": {"$ref": "omp-operation-types.schema.json#/$defs/identifier"}, "dependencies": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "omp-operation-types.schema.json#/$defs/identifier"}}, "execution_order": {"type": "integer", "minimum": 0, "maximum": 49}, "authorized_task": {"type": "string", "minLength": 1, "maxLength": 8192}, "requested_model": {"$ref": "omp-operation-types.schema.json#/$defs/model"}, "reasoning_effort": {"$ref": "omp-operation-types.schema.json#/$defs/reasoningEffort"}, "tool_policy": {"$ref": "omp-operation-types.schema.json#/$defs/toolPolicy"}, "native_authorization": {"type": "object", "additionalProperties": false, "required": ["dispatch_id", "runtime_project_id", "project_path_digest", "host_id", "authorization_boundary", "execution_mode", "access_mode", "work_type"], "properties": {"dispatch_id": {"type": "string", "pattern": "^dispatch-[0-9a-f]{24}$"}, "runtime_project_id": {"type": "string", "minLength": 8, "maxLength": 256}, "project_path_digest": {"$ref": "omp-operation-types.schema.json#/$defs/sha256"}, "host_id": {"$ref": "omp-operation-types.schema.json#/$defs/identifier"}, "authorization_boundary": {"$ref": "omp-operation-types.schema.json#/$defs/identifier"}, "execution_mode": {"enum": ["local", "worktree"]}, "access_mode": {"enum": ["read_only", "write"]}, "work_type": {"$ref": "omp-operation-types.schema.json#/$defs/identifier"}}}, "binding_state": {"enum": ["unbound", "bound"]}}}},
    "replayed": {"type": "boolean"}
  }
}
