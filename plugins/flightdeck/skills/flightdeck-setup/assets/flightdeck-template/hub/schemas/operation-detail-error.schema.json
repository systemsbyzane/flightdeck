{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-detail-error.schema.json",
  "title": "Flightdeck Operation Detail Error",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "error"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-detail.error/v1"},
    "schema": {"const": "hub/schemas/operation-detail-error.schema.json"},
    "ok": {"const": false},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {
      "code": {"enum": ["malformed_request", "unsupported_hub_contract", "operation_unavailable", "invalid_hub_state", "internal_error"]},
      "message": {"type": "string", "minLength": 1, "maxLength": 512}
    }}
  }
}
