{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/work-types.schema.json",
  "title": "Flightdeck Work control shared types",
  "$defs": {
    "workId": {"type": "string", "pattern": "^work-[0-9a-f]{24}$"},
    "operationId": {"type": "string", "pattern": "^operation-[0-9a-f]{24}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requestKey": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]+$"},
    "opaqueRuntimeId": {"type": "string", "minLength": 8, "maxLength": 256, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]+$"},
    "hubBindingId": {"type": "string", "pattern": "^hub-binding-[0-9a-f]{24}$"},
    "bindingId": {"type": "string", "pattern": "^adapter-binding-[0-9a-f]{24}$"},
    "sessionGeneration": {"type": "string", "pattern": "^adapter-session-[0-9a-f]{48}$"},
    "resumeGeneration": {"type": "string", "pattern": "^resume-[0-9a-f]{48}$"},
    "logicalProjectKey": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "authorizationBoundary": {"type": "string", "pattern": "^scope-[0-9a-f]{48}$"},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "available", "optional_controls"],
      "properties": {
        "adapter": {"enum": ["codex", "omp"]},
        "available": {"type": "boolean"},
        "optional_controls": {"type": "array", "uniqueItems": true, "items": {"enum": ["model", "reasoning_effort"]}}
      }
    },
    "runtimeBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "available", "turn_id", "binding_state", "optional_controls"],
      "properties": {
        "adapter": {"enum": ["codex", "omp"]},
        "available": {"type": "boolean"},
        "turn_id": {"type": "string", "pattern": "^turn-[0-9a-f]{24}$"},
        "binding_state": {"enum": ["unbound", "bound", "disconnected", "unavailable"]},
        "optional_controls": {"type": "array", "uniqueItems": true, "items": {"enum": ["model", "reasoning_effort"]}}
      }
    },
    "workSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["work_id", "title", "status", "created_at", "updated_at", "operation_count", "active_operation_id"],
      "properties": {
        "work_id": {"$ref": "#/$defs/workId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["open", "blocked", "operation_proposed", "operation_active", "unknown_outcome", "result_ready", "failed"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "operation_count": {"type": "integer", "minimum": 0, "maximum": 50},
        "active_operation_id": {"oneOf": [{"$ref": "#/$defs/operationId"}, {"type": "null"}]}
      }
    },
    "resume": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "adapter", "work_id", "generation", "last_event_id", "active_operation_id"],
      "properties": {
        "state": {"enum": ["binding_required", "available", "disconnected", "unavailable"]},
        "adapter": {"enum": ["codex", "omp"]},
        "work_id": {"$ref": "#/$defs/workId"},
        "generation": {"type": "string", "pattern": "^resume-[0-9a-f]{48}$"},
        "last_event_id": {"oneOf": [{"type": "string", "pattern": "^work-event-[0-9a-f]{24}$"}, {"type": "null"}]},
        "active_operation_id": {"oneOf": [{"$ref": "#/$defs/operationId"}, {"type": "null"}]}
      }
    },
    "recommendation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "recommendation_id", "disposition", "observed_at", "title", "work_intent", "target_project_keys", "access_mode", "execution_mode", "success_criteria", "non_goals"],
      "properties": {
        "schema_version": {"const": "flightdeck.runtime.work-recommendation/v1"},
        "recommendation_id": {"$ref": "#/$defs/requestKey"},
        "disposition": {"const": "operation"},
        "observed_at": {"type": "string", "format": "date-time"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "work_intent": {"type": "string", "minLength": 1, "maxLength": 2048},
        "target_project_keys": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/logicalProjectKey"}},
        "access_mode": {"enum": ["read_only", "write"]},
        "execution_mode": {"enum": ["local", "worktree"]},
        "success_criteria": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "non_goals": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    },
    "adapterObservation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "hub_binding_id", "work_id", "binding_id", "adapter", "adapter_session_id", "session_generation", "resume_generation", "structured_channel", "observation_id", "observation_type", "observed_at", "recommendation", "signature"],
          "properties": {
            "schema_version": {"const": "flightdeck.runtime.work-observation/v1"},
            "hub_binding_id": {"$ref": "#/$defs/hubBindingId"},
            "work_id": {"$ref": "#/$defs/workId"},
            "binding_id": {"$ref": "#/$defs/bindingId"},
            "adapter": {"enum": ["codex", "omp"]},
            "adapter_session_id": {"$ref": "#/$defs/opaqueRuntimeId"},
            "session_generation": {"$ref": "#/$defs/sessionGeneration"},
            "resume_generation": {"$ref": "#/$defs/resumeGeneration"},
            "structured_channel": {"const": "flightdeck.runtime.work-recommendation/v1"},
            "observation_id": {"$ref": "#/$defs/requestKey"},
            "observation_type": {"const": "managed_recommendation"},
            "observed_at": {"type": "string", "format": "date-time"},
            "recommendation": {"$ref": "#/$defs/recommendation"},
            "signature": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "hub_binding_id", "work_id", "binding_id", "adapter", "adapter_session_id", "session_generation", "resume_generation", "structured_channel", "observation_id", "observation_type", "observed_at", "signature"],
          "properties": {
            "schema_version": {"const": "flightdeck.runtime.work-observation/v1"},
            "hub_binding_id": {"$ref": "#/$defs/hubBindingId"},
            "work_id": {"$ref": "#/$defs/workId"},
            "binding_id": {"$ref": "#/$defs/bindingId"},
            "adapter": {"enum": ["codex", "omp"]},
            "adapter_session_id": {"$ref": "#/$defs/opaqueRuntimeId"},
            "session_generation": {"$ref": "#/$defs/sessionGeneration"},
            "resume_generation": {"$ref": "#/$defs/resumeGeneration"},
            "structured_channel": {"const": "flightdeck.runtime.work-recommendation/v1"},
            "observation_id": {"$ref": "#/$defs/requestKey"},
            "observation_type": {"const": "runtime_disconnected"},
            "observed_at": {"type": "string", "format": "date-time"},
            "signature": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_project_key", "display_label"],
      "properties": {
        "logical_project_key": {"$ref": "#/$defs/logicalProjectKey"},
        "display_label": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "plan_id", "plan_generation", "plan_digest", "plan_token", "title", "mode", "targets", "authorization"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/operationId"},
        "plan_id": {"type": "string", "pattern": "^plan-[0-9a-f]{48}$"},
        "plan_generation": {"type": "string", "pattern": "^generation-[0-9a-f]{48}$"},
        "plan_digest": {"$ref": "#/$defs/sha256"},
        "plan_token": {"$ref": "#/$defs/sha256"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "mode": {"const": "supervised"},
        "targets": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/target"}},
        "authorization": {
          "type": "object", "additionalProperties": false,
          "required": ["access_mode", "execution_mode", "external_actions_authorized"],
          "properties": {
            "access_mode": {"enum": ["read_only", "write"]},
            "execution_mode": {"enum": ["local", "worktree"]},
            "external_actions_authorized": {"const": false}
          }
        }
      }
    },
    "confirmation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "plan_id", "plan_generation", "plan_digest", "plan_token"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/operationId"},
        "plan_id": {"type": "string", "pattern": "^plan-[0-9a-f]{48}$"},
        "plan_generation": {"type": "string", "pattern": "^generation-[0-9a-f]{48}$"},
        "plan_digest": {"$ref": "#/$defs/sha256"},
        "plan_token": {"$ref": "#/$defs/sha256"}
      }
    },
    "proposalLifecycleState": {"enum": ["not_started", "declined", "launched", "launch_unknown"]},
    "proposalActions": {
      "type": "object", "additionalProperties": false,
      "required": ["confirm_and_launch", "decline"],
      "properties": {
        "confirm_and_launch": {"type": "boolean"},
        "decline": {"type": "boolean"}
      }
    },
    "dispatchState": {
      "enum": ["pending", "dispatch_pending", "dispatch_unknown", "awaiting_handoff", "running", "needs_approval", "blocked", "failed", "failed_validation", "runtime_failure", "review_ready", "stale", "cancelled", "complete", "unknown_outcome"]
    },
    "lifecycleDispatch": {
      "type": "object", "additionalProperties": false,
      "required": ["dispatch_id", "node_id", "logical_project_key", "state", "error_code", "updated_at"],
      "properties": {
        "dispatch_id": {"type": "string", "pattern": "^dispatch-[0-9a-f]{24}$"},
        "node_id": {"$ref": "#/$defs/logicalProjectKey"},
        "logical_project_key": {"$ref": "#/$defs/logicalProjectKey"},
        "state": {"$ref": "#/$defs/dispatchState"},
        "error_code": {"oneOf": [{"$ref": "#/$defs/logicalProjectKey"}, {"type": "null"}]},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "lifecycleProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal", "state", "state_observed_at", "declined_at", "launched_at", "actions", "dispatches"],
      "properties": {
        "proposal": {"$ref": "#/$defs/proposal"},
        "state": {"$ref": "#/$defs/proposalLifecycleState"},
        "state_observed_at": {"type": "string", "format": "date-time"},
        "declined_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "launched_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "actions": {"$ref": "#/$defs/proposalActions"},
        "dispatches": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/lifecycleDispatch"}}
      }
    },
    "bridgeArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "relative_path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bridgeHandoff": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "repository_id", "mode", "profile", "version", "original_checkout_path", "bridge_target_path", "bridge_target_relative_path", "bridge_target_sha256", "artifacts", "instruction_order", "worktree_policy", "copy_into_worktree"],
      "properties": {
        "status": {"const": "verified"},
        "repository_id": {"$ref": "#/$defs/logicalProjectKey"},
        "mode": {"enum": ["reference", "materialized", "repo-native"]},
        "profile": {"$ref": "#/$defs/logicalProjectKey"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "original_checkout_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "bridge_target_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "bridge_target_relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "bridge_target_sha256": {"$ref": "#/$defs/sha256"},
        "artifacts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/bridgeArtifact"}},
        "instruction_order": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "worktree_policy": {"enum": ["read_tracked_repo_native_bridge_in_active_worktree", "read_verified_bridge_from_original_checkout_when_ignored_target_absent"]},
        "copy_into_worktree": {"const": false}
      }
    },
    "dispatchRoute": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_id", "project_key", "runtime_project_id", "project_path", "mode", "authorization_boundary", "bridge_handoff"],
      "properties": {
        "repository_id": {"oneOf": [{"$ref": "#/$defs/logicalProjectKey"}, {"type": "null"}]},
        "project_key": {"$ref": "#/$defs/logicalProjectKey"},
        "runtime_project_id": {"$ref": "#/$defs/opaqueRuntimeId"},
        "project_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "mode": {"enum": ["local", "worktree", "remote"]},
        "authorization_boundary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "bridge_handoff": {"oneOf": [{"$ref": "#/$defs/bridgeHandoff"}, {"type": "null"}]}
      }
    },
    "dispatchTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["dispatch_id", "node_id", "logical_project_key", "runtime_project_id", "project_path_digest", "host_id", "authorization_boundary", "execution_mode", "access_mode", "work_type", "dependencies", "route"],
      "properties": {
        "dispatch_id": {"type": "string", "pattern": "^dispatch-[0-9a-f]{24}$"},
        "node_id": {"$ref": "#/$defs/logicalProjectKey"},
        "logical_project_key": {"$ref": "#/$defs/logicalProjectKey"},
        "runtime_project_id": {"$ref": "#/$defs/opaqueRuntimeId"},
        "project_path_digest": {"$ref": "#/$defs/sha256"},
        "host_id": {"$ref": "#/$defs/logicalProjectKey"},
        "authorization_boundary": {"$ref": "#/$defs/authorizationBoundary"},
        "execution_mode": {"enum": ["local", "worktree", "remote"]},
        "access_mode": {"enum": ["read_only", "write"]},
        "work_type": {"enum": ["research", "implementation", "review"]},
        "dependencies": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/logicalProjectKey"}},
        "route": {"$ref": "#/$defs/dispatchRoute"}
      }
    },
    "dispatchPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "max_concurrency", "requires_all_receipts", "retry_known_failures_only"],
      "properties": {
        "strategy": {"const": "parallel_independent"},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 8},
        "requires_all_receipts": {"const": true},
        "retry_known_failures_only": {"const": true}
      }
    },
    "dispatchResult": {
      "type": "object", "additionalProperties": false,
      "required": ["dispatch_id", "node_id", "attempt_key", "outcome", "runtime_project_id", "host_id", "project_path_digest", "task_id", "pending_client_id", "error_code"],
      "properties": {
        "dispatch_id": {"type": "string", "pattern": "^dispatch-[0-9a-f]{24}$"},
        "node_id": {"$ref": "#/$defs/logicalProjectKey"},
        "attempt_key": {"$ref": "#/$defs/requestKey"},
        "outcome": {"enum": ["created", "pending", "unknown_outcome", "failed"]},
        "runtime_project_id": {"$ref": "#/$defs/opaqueRuntimeId"},
        "host_id": {"$ref": "#/$defs/logicalProjectKey"},
        "project_path_digest": {"$ref": "#/$defs/sha256"},
        "task_id": {"oneOf": [{"$ref": "#/$defs/opaqueRuntimeId"}, {"type": "null"}]},
        "pending_client_id": {"oneOf": [{"$ref": "#/$defs/opaqueRuntimeId"}, {"type": "null"}]},
        "error_code": {"oneOf": [{"$ref": "#/$defs/logicalProjectKey"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"const": "created"}}, "required": ["outcome"]}, "then": {"properties": {"task_id": {"$ref": "#/$defs/opaqueRuntimeId"}, "error_code": {"type": "null"}}}},
        {"if": {"properties": {"outcome": {"const": "pending"}}, "required": ["outcome"]}, "then": {"properties": {"task_id": {"type": "null"}, "pending_client_id": {"$ref": "#/$defs/opaqueRuntimeId"}, "error_code": {"type": "null"}}}},
        {"if": {"properties": {"outcome": {"const": "unknown_outcome"}}, "required": ["outcome"]}, "then": {"properties": {"task_id": {"type": "null"}, "error_code": {"type": "null"}}}},
        {"if": {"properties": {"outcome": {"const": "failed"}}, "required": ["outcome"]}, "then": {"properties": {"task_id": {"type": "null"}, "pending_client_id": {"type": "null"}, "error_code": {"$ref": "#/$defs/logicalProjectKey"}}}}
      ]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["capability", "schema"],
      "properties": {
        "capability": {"type": "string", "minLength": 1, "maxLength": 256},
        "schema": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "type", "status", "observed_at", "operation_id", "evidence_id", "payload_digest", "source"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^work-event-[0-9a-f]{24}$"},
        "type": {"enum": ["work_created", "runtime_delegated", "runtime_unavailable", "runtime_disconnected", "operation_proposed", "operation_launched", "operation_launch_unknown", "operation_declined", "operation_dispatch_started", "operation_dispatch_pending", "operation_dispatch_unknown", "operation_dispatch_failed", "guidance_attached", "operation_progress", "operation_result"]},
        "status": {"enum": ["started", "completed", "blocked", "unknown_outcome", "in_progress", "available", "failed", "not_created"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "operation_id": {"oneOf": [{"$ref": "#/$defs/operationId"}, {"type": "null"}]},
        "evidence_id": {"$ref": "#/$defs/sha256"},
        "payload_digest": {"$ref": "#/$defs/sha256"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "operationLink": {
      "type": "object", "additionalProperties": false,
      "required": ["link_id", "operation_id", "relation", "authoring_outcome", "state", "result_state", "observed_at", "evidence_id", "source"],
      "properties": {
        "link_id": {"type": "string", "pattern": "^operation-link-[0-9a-f]{24}$"},
        "operation_id": {"$ref": "#/$defs/operationId"},
        "relation": {"enum": ["proposed", "active", "historical"]},
        "authoring_outcome": {"enum": ["created", "not_created", "unresolved"]},
        "state": {"type": ["string", "null"], "maxLength": 64},
        "result_state": {"enum": ["in_progress", "available", "failed", "not_created", "unknown_outcome"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_id": {"$ref": "#/$defs/sha256"},
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
