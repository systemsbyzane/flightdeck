{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-lifecycle-error.schema.json",
  "title": "Flightdeck Operation Lifecycle Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "ok", "error"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-lifecycle.error/v1"},
    "schema": {"const": "hub/schemas/operation-lifecycle-error.schema.json"},
    "ok": {"const": false},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["malformed_request", "unsupported_hub_contract", "capability_incomplete", "operation_unavailable", "operation_not_review_ready", "operation_not_terminal", "operation_not_archived", "duplicate_request_conflict", "request_limit_exceeded", "lifecycle_store_invalid", "conflicting_operation", "internal_error"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
