{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/skill-telemetry.schema.json",
  "title": "Flightdeck Mission skill telemetry v1",
  "description": "Bounded operation-wide projection of explicit structured Codex skill invocation events. Prompts, commands, paths, payloads, and evidence bodies are forbidden.",
  "oneOf": [
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/errorResult"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 128},
    "opaque": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
    "status": {"enum": ["started", "completed", "succeeded", "failed", "blocked", "unknown_outcome"]},
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id", "task_id", "host_id", "runtime_project_id", "logical_project_key",
        "project_label", "lifecycle_status", "first_observed_at", "last_observed_at",
        "event_count", "latest_evidence_id", "latest_event_digest", "evidence_source"
      ],
      "properties": {
        "node_id": {"$ref": "#/$defs/id"},
        "task_id": {"$ref": "#/$defs/opaque"},
        "host_id": {"$ref": "#/$defs/opaque"},
        "runtime_project_id": {"$ref": "#/$defs/opaque"},
        "logical_project_key": {"$ref": "#/$defs/id"},
        "project_label": {"$ref": "#/$defs/id"},
        "lifecycle_status": {"$ref": "#/$defs/status"},
        "first_observed_at": {"type": "string", "format": "date-time"},
        "last_observed_at": {"type": "string", "format": "date-time"},
        "event_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "latest_evidence_id": {"$ref": "#/$defs/opaque"},
        "latest_event_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_source": {"const": "codex_task_skill_event"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id", "skill_version", "lifecycle_status", "first_observed_at",
        "last_observed_at", "event_count", "children"
      ],
      "properties": {
        "skill_id": {"$ref": "#/$defs/id"},
        "skill_version": {"oneOf": [{"$ref": "#/$defs/version"}, {"type": "null"}]},
        "lifecycle_status": {"$ref": "#/$defs/status"},
        "first_observed_at": {"type": "string", "format": "date-time"},
        "last_observed_at": {"type": "string", "format": "date-time"},
        "event_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "children": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/child"}}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version", "kind", "schema", "capability", "operation_id",
        "snapshot_generation", "status", "partial_failure", "counts", "skills", "next_cursor"
      ],
      "properties": {
        "api_version": {"const": "flightdeck.skill-telemetry/v1"},
        "kind": {"const": "MissionSkillTelemetrySnapshot"},
        "schema": {"const": "hub/schemas/skill-telemetry.schema.json"},
        "capability": {"const": "flightdeck.command.skill-telemetry.v1"},
        "operation_id": {"$ref": "#/$defs/id"},
        "snapshot_generation": {"type": "integer", "minimum": 0},
        "status": {"enum": ["absent", "in_progress", "succeeded", "partial_failure"]},
        "partial_failure": {"type": "boolean"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skills", "children", "events", "failed_skills"],
          "properties": {
            "skills": {"type": "integer", "minimum": 0, "maximum": 1000},
            "children": {"type": "integer", "minimum": 0, "maximum": 1000},
            "events": {"type": "integer", "minimum": 0, "maximum": 1000},
            "failed_skills": {"type": "integer", "minimum": 0, "maximum": 1000}
          }
        },
        "skills": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/skill"}},
        "next_cursor": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^v1\\.[A-Za-z0-9_-]+$", "maxLength": 512}]}
      }
    },
    "errorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "kind", "schema", "capability", "ok", "error"],
      "properties": {
        "api_version": {"const": "flightdeck.skill-telemetry/v1"},
        "kind": {"const": "MissionSkillTelemetryError"},
        "schema": {"const": "hub/schemas/skill-telemetry.schema.json"},
        "capability": {"const": "flightdeck.command.skill-telemetry.v1"},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"enum": ["invalid_request", "invalid_limit", "invalid_cursor", "snapshot_changed", "operation_not_found", "unsupported_hub_contract", "incompatible_hub_contract", "malformed_operation_record"]},
            "message": {"type": "string", "minLength": 1, "maxLength": 256},
            "operation_id": {"$ref": "#/$defs/id"}
          }
        }
      }
    }
  }
}
