{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-lifecycle-request.schema.json",
  "title": "Flightdeck Operation Lifecycle Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation_id", "action"],
  "properties": {
    "schema_version": {"const": "flightdeck.operation-lifecycle.request/v1"},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "operation_id": {"type": "string", "pattern": "^operation-[0-9a-f]{24}$"},
    "action": {"enum": ["close", "archive", "restore"]}
  }
}
