{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dev/schemas/operation-execution-observe-result.schema.json",
  "title": "Persisted bounded Operation observation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema",
    "ok",
    "capability",
    "adapter",
    "operation_id",
    "execution_id",
    "execution_state",
    "agent",
    "replayed"
  ],
  "properties": {
    "schema_version": {
      "const": "flightdeck.operation-execution.observe-result/v1"
    },
    "schema": {
      "const": "hub/schemas/operation-execution-observe-result.schema.json"
    },
    "ok": {
      "const": true
    },
    "capability": {
      "const": "flightdeck.command.operation-observation.v1"
    },
    "adapter": {
      "$ref": "operation-execution-types.schema.json#/$defs/adapterDescriptor"
    },
    "operation_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/operationId"
    },
    "execution_id": {
      "$ref": "operation-execution-types.schema.json#/$defs/executionId"
    },
    "execution_state": {
      "enum": [
        "authorized",
        "running",
        "attention_required",
        "failed",
        "cancelled",
        "review_ready"
      ]
    },
    "agent": {
      "$ref": "operation-execution-types.schema.json#/$defs/safeAgent"
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
